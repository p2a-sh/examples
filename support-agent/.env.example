# Custom agent token. Required for `run`. Leave empty here.
P2A_TOKEN=
# Path to a file that holds P2A_TOKEN. A non-empty file wins. An empty file is unset.
P2A_TOKEN_FILE=
# Agent MCP URL. The SDK default is used when this is empty.
P2A_URL=
# Primary model key. OPENCHEAP_API_KEY is an alias. Leave empty here.
LLM_API_KEY=
LLM_API_KEY_FILE=
OPENCHEAP_API_KEY=
OPENCHEAP_API_KEY_FILE=
# OpenAI-compatible base URL and model.
LLM_BASE_URL=https://api.opencheap.si/v1
LLM_MODEL=deepseek-v4-pro
# USD per 1M tokens, used by the budget meter.
LLM_PRICE_IN_PER_M=0.06
LLM_PRICE_OUT_PER_M=0.12
# Fallback stays off unless this key and both fallback prices are set.
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_FILE=
FALLBACK_BASE_URL=https://openrouter.ai/api/v1
FALLBACK_MODEL=deepseek/deepseek-v4-pro
FALLBACK_PRICE_IN_PER_M=
FALLBACK_PRICE_OUT_PER_M=
LLM_TIMEOUT_MS=45000
# Comma-separated public URLs. Empty skips remote sources.
SOURCE_URLS=
# Comma-separated folders of documents.
DOCS_DIRS=./docs
DOCS_INCLUDE=md,mdx,txt,html,ts,py
DOCS_EXCLUDE=
# Prefix for citation links. Empty cites documents by path.
DOCS_BASE_URL=
# 1 rejects a bundle that fails the leak scan.
BUNDLE_STRICT=0
# Hours between automatic rebuilds. run also rebuilds at startup when the file is older.
BUNDLE_REFRESH_HOURS=24
STATE_DIR=./state
PRODUCT_NAME=p2a
# Empty means "the operator of this agent".
ESCALATION_CONTACT=
# Empty uses the docs base URL and the source URL origins.
ALLOWED_LINK_PREFIXES=
# Empty uses ESCALATION_CONTACT when that value is an email.
ALLOWED_EMAILS=
# Empty uses the packaged prompts/system.md.
PROMPT_FILE=
# Empty logs alerts and does not send them.
ALERT_TO=
ALERTS_PER_DAY=30
DAILY_BUDGET_USD=2.00
ENABLED=1
MAX_INPUT_CHARS=2000
MAX_OUTPUT_TOKENS=4000
MAX_REPLY_CHARS=3500
TOP_K=10
CONTEXT_TOKENS=3500
MIN_SCORE=2.0
MEMORY_TURNS=3
SENDER_BURST=6/600s
SENDER_PER_DAY=30
OWNER_PER_DAY=60
CONTEXT_TURNS_PER_DAY=20
GLOBAL_LLM_PER_DAY=3000
MAX_CONCURRENT=4
CONNECTION_POLICY=accept_capped
ACCEPTS_PER_DAY=150
LOG_LEVEL=info
# Linear filing. P2A is the only team. An empty key file disables filing.
P2A_SUPPORT_LINEAR_API_KEY=
P2A_SUPPORT_LINEAR_API_KEY_FILE=
P2A_SUPPORT_LINEAR_TEAM_KEY=P2A
P2A_SUPPORT_LINEAR_SHOW_URLS=0
# Questions asked before a thin bug report is filed. 0 files on the first message. Range 0-4.
CLARIFY_MAX_ROUNDS=2
# Hours an open clarification stays before it is dropped. Range 1-168.
CLARIFY_TTL_HOURS=24
