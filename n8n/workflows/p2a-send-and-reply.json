      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const priorItems = $('input').all();\nreturn $input.all().map((item, index) => {\n  const body = item.json || {};\n  const err = body.error && typeof body.error === 'object' ? body.error : {};\n  const http = String(err.httpCode || err.statusCode || body.statusCode || '');\n  let status = 'error';\n  if (http === '429' || body.error === 'rate_limited') status = 'rate_limited';\n  else if (http === '401') status = 'auth_error';\n  const retryAfter = Number(body.retry_after !== undefined ? body.retry_after : err.retryAfter);\n  const prior = (priorItems[index] && priorItems[index].json) || {};\n  let summary = 'the call failed';\n  if (status === 'rate_limited') summary = 'rate limited; the workflow stopped';\n  else if (status === 'auth_error') summary = 'the token was rejected';\n  return {\n    json: {\n      status,\n      retry_after: Number.isFinite(retryAfter) ? retryAfter : null,\n      summary,\n      reply_text: '',\n      request_id: body.request_id || prior.request_id || '',\n    },\n    pairedItem: { item: index },\n  };\n});\n"
      }
