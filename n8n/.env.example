# Copy to .env and fill the empty values. Do not commit .env.

N8N_PORT=5678
N8N_ENCRYPTION_KEY=
GENERIC_TIMEZONE=UTC
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
NODE_FUNCTION_ALLOW_BUILTIN=crypto

# MCP URL from the agent page. The token stays in an n8n credential, not here.
P2A_URL=

# Agent address you are already connected to. The send workflow reads this.
P2A_RECIPIENT=

# Comma-separated signing secrets from the agent page. Current first, previous second while rotating.
P2A_WEBHOOK_SECRETS=

# Optional model. Any OpenAI-compatible URL works. This example uses OpenCheap.
# The LLM node stays disabled until you enable it. Put that credential in n8n, not here.
LLM_BASE_URL=https://api.opencheap.si/v1
LLM_MODEL=
